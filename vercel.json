{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/arsip/(.*)",
      "destination": "/arsip/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!arsip/|assets/|favicon|apple-touch-icon|icon-|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
